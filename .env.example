# Conexão SSH com a VPS Contabo já provisionada.
SERVER_HOST=
SERVER_USER=
SSH_KEY_PATH=

# Opcional: porta SSH, padrão 22.
SSH_PORT=22

# Opcional: timezone aplicado na VPS quando informado.
BOOTSTRAP_TIMEZONE=America/Sao_Paulo

# Opcional: habilita configuração de UFW durante o bootstrap.
ENABLE_UFW=true

# Opcional: URL oficial do instalador do Coolify.
COOLIFY_INSTALL_URL=https://cdn.coollabs.io/coolify/install.sh

# Opcional: diretório padrão usado pelo Coolify self-hosted.
COOLIFY_EXPECTED_DIR=/data/coolify/source

# Opcional: URL oficial do instalador do Foundry/foundryctl.
FOUNDRY_INSTALL_URL=https://signoz.io/foundry.sh

# Opcional: versão específica do Foundry/foundryctl. Deixe vazio para usar latest.
FOUNDRY_VERSION=

# Opcional: caminho onde o binário foundryctl será instalado na VPS.
FOUNDRY_BIN_PATH=/usr/local/bin/foundryctl

# Opcional: diretório usado pelo SigNoz/Foundry na VPS.
SIGNOZ_DIR=/data/signoz

# Opcional: porta pública da UI do SigNoz na VPS.
SIGNOZ_UI_PORT=8081

# Opcional: abre portas públicas do SigNoz quando a task observability:firewall executa.
ENABLE_SIGNOZ_FIREWALL=true

# Opcional: habilita a task dedicada do collector PostgreSQL.
POSTGRES_COLLECTOR_ENABLED=true

# Opcional: diretório operacional privado do collector PostgreSQL na VPS.
POSTGRES_COLLECTOR_DIR=/data/signoz-integrations/postgres-collector

# Opcional: imagem do OpenTelemetry Collector usada pelo collector PostgreSQL.
POSTGRES_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.139.0

# Opcional: nome do container do collector PostgreSQL.
POSTGRES_COLLECTOR_CONTAINER=espresso-postgres-collector

# Opcional: rede Docker onde o PostgreSQL da aplicação gerenciado pelo Coolify está acessível.
POSTGRES_COLLECTOR_COOLIFY_NETWORK=coolify

# Opcional: rede Docker onde o SigNoz ingester está acessível.
POSTGRES_COLLECTOR_SIGNOZ_NETWORK=signoz-network

# Opcional: endpoint OTLP interno do SigNoz na rede Docker do SigNoz.
POSTGRES_COLLECTOR_SIGNOZ_ENDPOINT=signoz-ingester:4317

# Opcional: projeto Coolify usado para localizar o PostgreSQL da aplicação.
POSTGRES_COLLECTOR_COOLIFY_PROJECT=espresso

# Opcional: informe para evitar autodetecção do container PostgreSQL do Coolify.
POSTGRES_COLLECTOR_POSTGRES_CONTAINER=

# Opcional: hostname usado pelo collector para acessar o PostgreSQL. Quando vazio, usa o container detectado.
POSTGRES_COLLECTOR_POSTGRES_HOST=

# Opcional: porta interna do PostgreSQL.
POSTGRES_COLLECTOR_POSTGRES_PORT=5432

# Opcional: banco alvo. Quando vazio, usa POSTGRES_DB do container PostgreSQL.
POSTGRES_COLLECTOR_POSTGRES_DB=

# Opcional: usuário monitor criado no PostgreSQL da aplicação.
POSTGRES_MONITOR_USER=espresso_otel_monitor

# Opcional: intervalo de coleta de métricas do PostgreSQL.
POSTGRES_COLLECTOR_INTERVAL=30s

# Opcional: atributo deployment.environment aplicado às métricas do collector.
POSTGRES_COLLECTOR_ENVIRONMENT=production
