# Conexão SSH com a VPS Contabo já provisionada.
SERVER_HOST=
SERVER_USER=
SSH_KEY_PATH=

# Opcional: porta SSH, padrão 22.
SSH_PORT=22

# Opcional: timezone aplicado na VPS quando informado.
BOOTSTRAP_TIMEZONE=America/Sao_Paulo

# Opcional: habilita configuração de UFW durante o bootstrap.
ENABLE_UFW=true

# Opcional: URL oficial do instalador do Coolify.
COOLIFY_INSTALL_URL=https://cdn.coollabs.io/coolify/install.sh

# Opcional: diretório padrão usado pelo Coolify self-hosted.
COOLIFY_EXPECTED_DIR=/data/coolify/source
